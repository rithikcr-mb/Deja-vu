# Copy to .env. Keep live generation disabled until you confirm the Gemini key
# and data-use tier are acceptable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ENABLE_LIVE_GEMINI=false
DEJAVU_FAKE_AI=false
# Optional. If unset, a random local key is generated for this server process.
FLASK_SECRET_KEY=
